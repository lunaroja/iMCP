<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>__HOST__.home-helper</string>
    <key>BundleProgram</key>
    <string>Contents/Helpers/iMCP Home.app/Contents/MacOS/iMCP Helper</string>
    <key>AssociatedBundleIdentifiers</key>
    <array><string>__HOST__</string></array>
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>MachServices</key>
    <dict>
        <key>__HOST__.home-xpc</key>
        <true/>
    </dict>
</dict>
</plist>
